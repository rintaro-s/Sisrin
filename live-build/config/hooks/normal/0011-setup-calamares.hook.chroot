#!/bin/bash
# 0011-setup-calamares.hook.chroot
# Calamares インストーラーの Sisrin ブランディング設定
set -e

echo "[Sisrin] Calamares インストーラーを設定します"

CALAMARES_DIR="/etc/calamares"
BRANDING_DIR="${CALAMARES_DIR}/branding/sisrin"
MODULES_DIR="${CALAMARES_DIR}/modules"

mkdir -p "$BRANDING_DIR" "$MODULES_DIR"

# ============================================================
# settings.conf — メインシーケンス定義
# ============================================================
cat > "${CALAMARES_DIR}/settings.conf" << 'EOF'
---
modules-search: [ local, /usr/lib/calamares/modules ]

instances:
  - id: before_bootloader
    module: shellprocess
    config: shellprocess_pre.conf
  - id: after_bootloader
    module: shellprocess
    config: shellprocess_post.conf

sequence:
  - show:
      - welcome
      - locale
      - keyboard
      - partition
      - users
      - summary
  - exec:
      - partition
      - mount
      - unpackfs
      - machineid
      - fstab
      - locale
      - keyboard
      - localecfg
      - luksbootkeyfile
      - users
      - displaymanager
      - networkcfg
      - hwclock
      - services-systemd
      - grubcfg
      - shellprocess@before_bootloader
      - bootloader
      - shellprocess@after_bootloader
      - packages
      - removeuser
      - umount
  - show:
      - finished

branding: sisrin
prompt-install: false
dont-chroot: false
oem-setup: false
disable-cancel: false
disable-cancel-during-exec: false
quit-at-end: false
EOF

# ============================================================
# branding.desc — Sisrin ブランディング
# ============================================================
cat > "${BRANDING_DIR}/branding.desc" << 'EOF'
---
componentName: sisrin

welcomeStyleCalamares: false
welcomeExpandingLogo: true

strings:
  productName:      "Sisrin OS"
  shortProductName: "Sisrin"
  version:          "1.0"
  shortVersion:     "1.0"
  versionedName:    "Sisrin OS 1.0"
  shortVersionedName: "Sisrin 1.0"
  bootloaderEntryName: "Sisrin OS"
  productUrl:       "https://github.com/rintaro-s"
  supportUrl:       "https://github.com/rintaro-s"
  knownIssuesUrl:   "https://github.com/rintaro-s"
  releaseNotesUrl:  "https://github.com/rintaro-s"
  donateUrl:        ""

images:
  productLogo:      "sisrin-logo.png"
  productIcon:      "sisrin-logo.png"
  productWelcome:   "languages.png"

slideshow: "show.qml"
slideshowAPI: 2

style:
  sidebarBackground:    "#1a1a2e"
  sidebarText:          "#e0e0e0"
  sidebarTextSelect:    "#ffffff"
  sidebarTextHighlight: "#6c63ff"
EOF

# ============================================================
# show.qml — スライドショー（シンプル版）
# ============================================================
cat > "${BRANDING_DIR}/show.qml" << 'EOF'
import QtQuick 2.0
import calamares.slideshow 1.0

Presentation {
    id: presentation
    Slide {
        anchors.fill: parent
        Rectangle {
            anchors.fill: parent
            color: "#1a1a2e"
            Column {
                anchors.centerIn: parent
                spacing: 20
                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: "Sisrin OS へようこそ"
                    color: "#ffffff"
                    font.pixelSize: 32
                    font.bold: true
                }
                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: "インストール中です。しばらくお待ちください..."
                    color: "#b0b0b0"
                    font.pixelSize: 16
                }
            }
        }
    }
}
EOF

# ============================================================
# ロゴシンボルリンク (壁紙をロゴ代わりに使用)
# ============================================================
LOGO_PATH="/usr/share/sisrin/logo.png"
WALLPAPER_PATH="/usr/share/sisrin/wallpaper.png"
if [ -f "$LOGO_PATH" ]; then
    cp "$LOGO_PATH" "${BRANDING_DIR}/sisrin-logo.png"
elif [ -f "$WALLPAPER_PATH" ]; then
    cp "$WALLPAPER_PATH" "${BRANDING_DIR}/sisrin-logo.png"
fi

# languages.png (Calamares 付属のロゴを使用)
LANGS_SRC="/usr/share/calamares/branding/default/languages.png"
if [ -f "$LANGS_SRC" ]; then
    cp "$LANGS_SRC" "${BRANDING_DIR}/languages.png"
fi

# ============================================================
# partition.conf — パーティション設定
# ============================================================
cat > "${MODULES_DIR}/partition.conf" << 'EOF'
---
efiSystemPartition: "/boot/efi"
efiSystemPartitionSize: 512M
efiSystemPartitionName: "EFI"

userSwapChoices:
    - none
    - small
    - suspend
    - file

drawNestedPartitions: false
alwaysShowPartitionLabels: true
initialPartitioningChoice: erase
initialSwapChoice: small

defaultFileSystemType: "ext4"
availableFileSystemTypes:
    - ext4
    - btrfs
    - xfs
EOF

# ============================================================
# mount.conf — マウント設定
# ============================================================
cat > "${MODULES_DIR}/mount.conf" << 'EOF'
---
extraMounts:
    - device: proc
      fs: proc
      mountPoint: /proc
    - device: sys
      fs: sysfs
      mountPoint: /sys
    - device: /dev
      mountPoint: /dev
      options: [ bind ]
    - device: tmpfs
      fs: tmpfs
      mountPoint: /run
    - device: /run/udev
      mountPoint: /run/udev
      options: [ bind ]

bios:
    mountPoint: /boot/grub
    
efiMountOptions: umask=0077
EOF

# ============================================================
# fstab.conf — fstab 生成設定
# ============================================================
cat > "${MODULES_DIR}/fstab.conf" << 'EOF'
---
mountOptions:
    default: defaults,noatime
    btrfs: defaults,noatime,compress=zstd:1

ssdExtraMountOptions:
    ext4: discard
    btrfs: discard=async

crypttabOptions: luks
EOF

# ============================================================
# unpackfs.conf — squashfs の展開設定
# ============================================================
cat > "${MODULES_DIR}/unpackfs.conf" << 'EOF'
---
unpack:
    - source: /run/live/medium/live/filesystem.squashfs
      sourcefs: squashfs
      destination: ""
EOF

# ============================================================
# locale.conf — ロケール設定
# ============================================================
cat > "${MODULES_DIR}/locale.conf" << 'EOF'
---
region: "Asia"
zone: "Tokyo"
localeGenPath: /etc/locale.gen
geoip:
    style: "none"
EOF

# ============================================================
# keyboard.conf — キーボード設定
# ============================================================
cat > "${MODULES_DIR}/keyboard.conf" << 'EOF'
---
xorgKeyboard:
    keysDir: "/usr/share/X11/xkb/rules"
    rulesFile: "evdev"
    writeEtcDefaultKeyboard: true

# デフォルトキーボードレイアウトを日本語に
defaultLayout: jp
defaultVariant: ""
defaultOptions: ""
EOF

# ============================================================
# users.conf  — ユーザー作成設定
# ============================================================
cat > "${MODULES_DIR}/users.conf" << 'EOF'
---
defaultGroups:
    - name: users
      state: present
    - name: sudo
      state: present
    - name: lp
      state: present
    - name: video
      state: present
    - name: network
      state: present
    - name: storage
      state: present
    - name: wheel
      state: present
    - name: audio
      state: present

autologinGroup: autologin
sudoersGroup: sudo
setRootPassword: false
doAutologin: false
doReusePassword: true
passwordRequirements:
    minLength: 8

userShell: /usr/bin/zsh

avatar:
    avatar: "/usr/share/sisrin/wallpaper.png"
EOF

# ============================================================
# displaymanager.conf — GDM3
# ============================================================
cat > "${MODULES_DIR}/displaymanager.conf" << 'EOF'
---
displaymanagers:
    - gdm3

basicSetup: false
sysconfigSetup: false
EOF

# ============================================================
# packages.conf — インストール後不要パッケージ削除
# ============================================================
cat > "${MODULES_DIR}/packages.conf" << 'EOF'
---
backend: apt

operations:
    - remove:
          - live-boot
          - live-boot-initramfs-tools
          - live-config
          - live-config-systemd
          - calamares
          - squashfs-tools
EOF

# ============================================================
# shellprocess_pre.conf — ブートローダー前の処理 (BIOS用grub-pc)
# ============================================================
cat > "${MODULES_DIR}/shellprocess_pre.conf" << 'EOF'
---
dontChroot: false
timeout: 300

script:
    # BIOS システムの場合は grub-pc をインストール
    - command: "test -d /sys/firmware/efi || apt-get update"
      timeout: 60
    - command: "test -d /sys/firmware/efi || DEBIAN_FRONTEND=noninteractive apt-get install -y grub-pc"
      timeout: 180
EOF

# ============================================================
# shellprocess_post.conf — ブートローダー後の処理 (GRUB設定)
# ============================================================
cat > "${MODULES_DIR}/shellprocess_post.conf" << 'EOF'
---
dontChroot: false
timeout: 300

script:
    # GRUB設定のリブランド
    - command: "sed -i 's/Debian GNU\\/Linux/Sisrin OS/g' /etc/default/grub"
      timeout: 10
    - command: "sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR=\"Sisrin OS\"/' /etc/default/grub"
      timeout: 10
    # OS-PROBER有効化（マルチブート対応）
    - command: "sed -i 's/^#*GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub"
      timeout: 10
    - command: "grep -q '^GRUB_DISABLE_OS_PROBER' /etc/default/grub || echo 'GRUB_DISABLE_OS_PROBER=false' >> /etc/default/grub"
      timeout: 10
    # GRUB_DEFAULT=0 に設定（最初のカーネルエントリ＝最新カーネル）
    - command: "sed -i 's/^GRUB_DEFAULT=.*/GRUB_DEFAULT=0/' /etc/default/grub"
      timeout: 10
    - command: "sed -i 's/Debian/Sisrin OS/g' /etc/grub.d/10_linux"
      timeout: 10
    - command: "sed -i 's/Debian/Sisrin OS/g' /etc/grub.d/30_os-prober"
      timeout: 10
    - command: "update-grub"
      timeout: 120
    - command: "sed -i 's/Debian GNU\\/Linux/Sisrin OS/g' /boot/grub/grub.cfg"
      timeout: 10
    - command: "sed -i 's/Debian/Sisrin OS/g' /boot/grub/grub.cfg"
      timeout: 10
    # Fcitx5をデフォルトIMに設定
    - command: "im-config -n fcitx5"
      timeout: 10
    - command: "/usr/bin/dconf update"
      timeout: 30
EOF

# ============================================================
# services-systemd.conf — GDM3 有効化
# ============================================================
cat > "${MODULES_DIR}/services-systemd.conf" << 'EOF'
---
services:
    - name: gdm3
      preset: true
      enable: true
    - name: NetworkManager
      preset: true
      enable: true
    - name: lil-hardware-watchdog
      preset: true
      enable: true

targets:
    - name: graphical
      set: default
EOF

# ============================================================
# networkcfg.conf — ホスト名デフォルト
# ============================================================
cat > "${MODULES_DIR}/networkcfg.conf" << 'EOF'
---
mdns: false
EOF

# ============================================================
# bootloader.conf — GRUB インストール設定
# ============================================================
cat > "${MODULES_DIR}/bootloader.conf" << 'EOF'
---
efiBootLoader: "grub"
kernel: "/vmlinuz"
img: "/initrd.img"
kernelLine: "quiet splash"
kernelParams: [ "quiet", "splash" ]
timeout: 1

grubInstall:    "grub-install"
grubMkconfig:   "grub-mkconfig"
grubCfg:        "/boot/grub/grub.cfg"
grubProbe:      "grub-probe"
efiBootMgr:     "efibootmgr"

installEFIfallback: true
efiBootloaderId: "sisrin"
EOF

# ============================================================
# grubcfg.conf — GRUB 設定ファイル生成
# ============================================================
cat > "${MODULES_DIR}/grubcfg.conf" << 'EOF'
---
timeout: 1
timeout_style: countdown
distributor: "Sisrin OS"
EOF

# ============================================================
# welcome.conf — 最低システム要件
# ============================================================
cat > "${MODULES_DIR}/welcome.conf" << 'EOF'
---
showSupportUrl:    false
showKnownIssuesUrl: false
showReleaseNotesUrl: false
showDonateUrl:     false

requirements:
    requiredStorage:     15.0
    requiredRam:         2.0
    check:
        - storage
        - ram
        - power
        - internet
    required:
        - storage
        - ram
EOF

# ============================================================
# finished.conf — 完了画面の自動再起動設定
# ============================================================
cat > "${MODULES_DIR}/finished.conf" << 'EOF'
---
restartNowEnabled: true
restartNowChecked: true
restartNowCommand: "systemctl reboot"
EOF

# ============================================================
# removeuser.conf — ライブユーザーを削除
# ============================================================
cat > "${MODULES_DIR}/removeuser.conf" << 'EOF'
---
username: "user"
EOF

# ============================================================
# machineid.conf
# ============================================================
cat > "${MODULES_DIR}/machineid.conf" << 'EOF'
---
systemd: true
dbus: true
symlink: true
EOF

# ============================================================
# Calamares polkit 権限 (sudo なしで起動できるように)
# ============================================================
cat > /usr/share/polkit-1/actions/com.github.calamares.calamares.policy << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="com.github.calamares.calamares.install">
    <description>Install Sisrin OS</description>
    <message>Administrator privilege is required to install Sisrin OS</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
EOF

echo "[Sisrin] Calamares 設定完了"

# ============================================================
# デスクトップ インストーラー ショートカット
# ============================================================
INSTALL_DESKTOP="/usr/share/applications/sisrin-install.desktop"
cat > "$INSTALL_DESKTOP" << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Sisrin OS をインストール
Name[en]=Install Sisrin OS
GenericName=System Installer
Comment=ディスクに Sisrin OS をインストールします
Comment[en]=Install Sisrin OS to disk
Exec=pkexec calamares
Icon=/usr/share/sisrin/logo.png
Terminal=false
Categories=System;
Keywords=install;installer;calamares;sisrin;
EOF

# ライブデスクトップにも配置
DESKTOP_DIR="/home/user/Desktop"
mkdir -p "$DESKTOP_DIR"
cp "$INSTALL_DESKTOP" "${DESKTOP_DIR}/sisrin-install.desktop"
chmod +x "${DESKTOP_DIR}/sisrin-install.desktop"
chown 1000:1000 "${DESKTOP_DIR}/sisrin-install.desktop"

# GNOME がデスクトップアイコンを信頼済みとして扱うように
mkdir -p /home/user/.local/share/applications
cp "$INSTALL_DESKTOP" /home/user/.local/share/applications/
chown -R 1000:1000 /home/user/.local /home/user/Desktop 2>/dev/null || true

echo "[Sisrin] インストーラーショートカット作成完了"

# ============================================================
# Calamares 自動起動設定
# ============================================================
mkdir -p /etc/xdg/autostart
cat > /etc/xdg/autostart/sisrin-installer-autostart.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=Sisrin OS Installer
Exec=sh -c 'sleep 1 && pkexec calamares'
Hidden=false
NoDisplay=false
Terminal=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=1
OnlyShowIn=GNOME;
EOF

mkdir -p /home/user/.config/autostart
cp /etc/xdg/autostart/sisrin-installer-autostart.desktop /home/user/.config/autostart/
AUTOSTART_CALAMARES="/home/user/.config/autostart/sisrin-installer-autostart.desktop"
chown -R 1000:1000 /home/user/.config/autostart

echo "[Sisrin] インストーラー自動起動を設定しました（1秒後に起動）"

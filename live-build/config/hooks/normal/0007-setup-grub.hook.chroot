#!/bin/bash
# 0007-setup-grub.hook.chroot
# GRUB タイムアウトを 1 秒に固定する
set -e

echo "[Sisrin] GRUB タイムアウトを 1 秒に設定します"

GRUB_DEFAULT="/etc/default/grub"

if [ -f "$GRUB_DEFAULT" ]; then
    # GRUB_TIMEOUT を 1 に設定
    sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=1/' "$GRUB_DEFAULT"
    # 設定が存在しない場合は追加
    grep -q '^GRUB_TIMEOUT=' "$GRUB_DEFAULT" || echo "GRUB_TIMEOUT=1" >> "$GRUB_DEFAULT"

    # 即時タイムアウトスタイルをカウントダウンに設定 (1秒カウントダウン)
    sed -i 's/^GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=countdown/' "$GRUB_DEFAULT"
    grep -q '^GRUB_TIMEOUT_STYLE=' "$GRUB_DEFAULT" || echo "GRUB_TIMEOUT_STYLE=countdown" >> "$GRUB_DEFAULT"

    # "Debian" 表記を "Sisrin" に変更
    sed -i 's/Debian GNU\/Linux/Sisrin OS/g' "$GRUB_DEFAULT"
    sed -i "s/GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR=\"Sisrin OS\"/" "$GRUB_DEFAULT"

    # GRUB テーマ設定 (存在すれば適用)
    grep -q '^GRUB_THEME=' "$GRUB_DEFAULT" || echo 'GRUB_THEME=""' >> "$GRUB_DEFAULT"

    echo "[Sisrin] /etc/default/grub の設定:"
    grep -E '^GRUB_TIMEOUT|^GRUB_DISTRIBUTOR|^GRUB_THEME' "$GRUB_DEFAULT"
else
    echo "[Sisrin] 警告: ${GRUB_DEFAULT} が見つかりません"
fi

# GRUB 設定の再生成
if command -v update-grub &>/dev/null; then
    update-grub 2>/dev/null || true
fi

# /boot/grub/grub.cfg 内の "Debian" 表記も書き換え (存在する場合)
if [ -f /boot/grub/grub.cfg ]; then
    sed -i 's/Debian GNU\/Linux/Sisrin OS/g' /boot/grub/grub.cfg
    sed -i 's/menuentry.*Debian/menuentry "Sisrin OS/g' /boot/grub/grub.cfg
fi

echo "[Sisrin] GRUB 設定完了"

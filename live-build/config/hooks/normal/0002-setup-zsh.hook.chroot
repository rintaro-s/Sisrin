#!/bin/bash
# 0002-setup-zsh.hook.chroot
# zsh をデフォルトシステムシェルに設定し、
# ログイン時に Sish が自動起動されるよう構成する
set -e

echo "[Sisrin] zsh をデフォルトシェルに設定します"

# zsh がインストールされているか確認
which zsh || apt-get install -y zsh

ZSH_PATH=$(which zsh)

# システム全体のデフォルトシェルを zsh に変更
chsh -s "$ZSH_PATH" root 2>/dev/null || true

# /etc/default/useradd を書き換えて新規ユーザーのデフォルトシェルも zsh に
if [ -f /etc/default/useradd ]; then
    sed -i "s|^SHELL=.*|SHELL=${ZSH_PATH}|" /etc/default/useradd
fi

# /etc/shells に zsh を追加 (未登録の場合)
grep -qxF "$ZSH_PATH" /etc/shells || echo "$ZSH_PATH" >> /etc/shells

# ライブ環境の標準ユーザー (user) のシェルも変更
if id user &>/dev/null; then
    chsh -s "$ZSH_PATH" user
fi

# /usr/local/bin/sish ラッパーを作成（存在する場合は実行、無ければ zsh にフォールバック）
cat > /usr/local/bin/sish << 'SH'
#!/bin/sh
if [ -x /home/user/Sisrin/Sish/sish ]; then
  exec env SISH_LANG=en /home/user/Sisrin/Sish/sish "$@"
else
  exec /usr/bin/zsh "$@"
fi
SH
chmod +x /usr/local/bin/sish

# /etc/shells に登録
grep -qxF "/usr/local/bin/sish" /etc/shells || echo "/usr/local/bin/sish" >> /etc/shells

# デフォルトシェルを /usr/local/bin/sish に設定（既存ユーザーと新規ユーザー）
if id user &>/dev/null; then
    chsh -s /usr/local/bin/sish user || true
fi
chsh -s /usr/local/bin/sish root 2>/dev/null || true
if [ -f /etc/default/useradd ]; then
    sed -i "s|^SHELL=.*|SHELL=/usr/local/bin/sish|" /etc/default/useradd || true
fi

# /etc/zsh/zshrc に Sish 自動起動の設定を追加（zsh 経由でも wrapper を使う）
cat >> /etc/zsh/zshrc << 'EOF'

# --- Sisrin: Sish 自動起動 ---
_SISH_WRAPPER="/usr/local/bin/sish"
if [[ -x "${_SISH_WRAPPER}" ]] && [[ -t 0 ]]; then
    if [[ "${SISH_RUNNING}" != "1" ]]; then
        export SISH_RUNNING=1
        exec "${_SISH_WRAPPER}"
    fi
fi
unset _SISH_WRAPPER
EOF

echo "[Sisrin] zsh デフォルトシェル設定完了"

#!/bin/bash
# 0008-setup-wallpaper.hook.chroot
# 壁紙を設定し、GNOME のデフォルト壁紙として構成する
set -e

echo "[Sisrin] 壁紙を設定します"

WALLPAPER_SRC="/usr/share/sisrin/wallpaper.png"
WALLPAPER_DEST="/usr/share/backgrounds/sisrin-wallpaper.png"

mkdir -p /usr/share/sisrin
mkdir -p /usr/share/backgrounds

if [ ! -f "$WALLPAPER_SRC" ]; then
    echo "[Sisrin] 警告: 壁紙ファイルが見つかりません: ${WALLPAPER_SRC}"
    WALLPAPER_DEST="/usr/share/gnome-control-center/pixmaps/noise-texture.png"
else
    cp "$WALLPAPER_SRC" "$WALLPAPER_DEST"
    echo "[Sisrin] 壁紙をコピーしました: ${WALLPAPER_DEST}"
fi

# --- GNOME dconf システムプロファイル ---
mkdir -p /etc/dconf/profile
cat > /etc/dconf/profile/user << 'EOF'
user-db:user
system-db:sisrin
EOF

mkdir -p /etc/dconf/db/sisrin.d
cat > /etc/dconf/db/sisrin.d/01-sisrin-wallpaper << EOF
[org/gnome/desktop/background]
picture-uri='file://${WALLPAPER_DEST}'
picture-uri-dark='file://${WALLPAPER_DEST}'
picture-options='zoom'
primary-color='#000000'

[org/gnome/desktop/screensaver]
picture-uri='file://${WALLPAPER_DEST}'
picture-options='zoom'
primary-color='#000000'
EOF

# dconf DB 更新
if command -v dconf &>/dev/null; then
    dconf update 2>/dev/null || true
fi

# --- GDM3 グリーター背景 (CSS 上書き) ---
for css_dir in /usr/share/gnome-shell/theme /usr/share/gnome-shell/theme/Yaru; do
    if [ -d "$css_dir" ] && [ -f "$WALLPAPER_DEST" ]; then
        for css in "$css_dir"/gdm3.css "$css_dir"/gnome-shell.css; do
            [ -f "$css" ] || continue
            # lockDialogGroup の背景を差し替え
            if grep -q 'lockDialogGroup' "$css"; then
                sed -i "s|#lockDialogGroup.*{.*}|#lockDialogGroup { background: #000000 url(file://${WALLPAPER_DEST}) center/cover no-repeat; }|" "$css" || true
            else
                echo "#lockDialogGroup { background: #000000 url(file://${WALLPAPER_DEST}) center/cover no-repeat; }" >> "$css"
            fi
        done
    fi
done

# --- /etc/skel 自動スタート (初回ログイン時に壁紙を確実に適用) ---
mkdir -p /etc/skel/.config/autostart
cat > /etc/skel/.config/autostart/sisrin-wallpaper.desktop << EOF
[Desktop Entry]
Type=Application
Name=Sisrin Wallpaper Apply
Exec=gsettings set org.gnome.desktop.background picture-uri 'file://${WALLPAPER_DEST}'
Hidden=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF

# ライブユーザーにも適用
if [ -d /home/user ]; then
    mkdir -p /home/user/.config/autostart
    cp /etc/skel/.config/autostart/sisrin-wallpaper.desktop \
       /home/user/.config/autostart/
    chown -R 1000:1000 /home/user/.config 2>/dev/null || true
fi

echo "[Sisrin] 壁紙設定完了"
